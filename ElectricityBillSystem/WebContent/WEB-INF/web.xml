<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Electricity Bill System</display-name>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Customer Registration -->
    <servlet>
        <servlet-name>CustomerRegistrationServlet</servlet-name>
        <servlet-class>com.ebs.servlet.CustomerRegistrationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerRegistrationServlet</servlet-name>
        <url-pattern>/registerCustomer</url-pattern>
    </servlet-mapping>

    <!-- Admin Registration -->
    <servlet>
        <servlet-name>AdminRegistrationServlet</servlet-name>
        <servlet-class>com.ebs.servlet.AdminRegistrationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminRegistrationServlet</servlet-name>
        <url-pattern>/registerAdmin</url-pattern>
    </servlet-mapping>

    <!-- Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.ebs.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.ebs.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- View Bills -->
    <servlet>
        <servlet-name>ViewBillsServlet</servlet-name>
        <servlet-class>com.ebs.servlet.ViewBillsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewBillsServlet</servlet-name>
        <url-pattern>/viewBills</url-pattern>
    </servlet-mapping>

    <!-- Pay Bill -->
    <servlet>
        <servlet-name>PayBillServlet</servlet-name>
        <servlet-class>com.ebs.servlet.PayBillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PayBillServlet</servlet-name>
        <url-pattern>/payBill</url-pattern>
    </servlet-mapping>

    <!-- Bill History -->
    <servlet>
        <servlet-name>BillHistoryServlet</servlet-name>
        <servlet-class>com.ebs.servlet.BillHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillHistoryServlet</servlet-name>
        <url-pattern>/billHistory</url-pattern>
    </servlet-mapping>

    <!-- Register Complaint -->
    <servlet>
        <servlet-name>RegisterComplaintServlet</servlet-name>
        <servlet-class>com.ebs.servlet.RegisterComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterComplaintServlet</servlet-name>
        <url-pattern>/registerComplaint</url-pattern>
    </servlet-mapping>

    <!-- Search Complaint -->
    <servlet>
        <servlet-name>SearchComplaintServlet</servlet-name>
        <servlet-class>com.ebs.servlet.SearchComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchComplaintServlet</servlet-name>
        <url-pattern>/searchComplaint</url-pattern>
    </servlet-mapping>

    <!-- Complaint History -->
    <servlet>
        <servlet-name>ComplaintHistoryServlet</servlet-name>
        <servlet-class>com.ebs.servlet.ComplaintHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintHistoryServlet</servlet-name>
        <url-pattern>/complaintHistory</url-pattern>
    </servlet-mapping>

    <!-- Customer Update -->
    <servlet>
        <servlet-name>UpdateCustomerServlet</servlet-name>
        <servlet-class>com.ebs.servlet.UpdateCustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateCustomerServlet</servlet-name>
        <url-pattern>/updateCustomer</url-pattern>
    </servlet-mapping>

    <!-- Soft Delete Account -->
    <servlet>
        <servlet-name>DeleteAccountServlet</servlet-name>
        <servlet-class>com.ebs.servlet.DeleteAccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteAccountServlet</servlet-name>
        <url-pattern>/deleteAccount</url-pattern>
    </servlet-mapping>

    <!-- Admin: Add Bill -->
    <servlet>
        <servlet-name>AddBillServlet</servlet-name>
        <servlet-class>com.ebs.servlet.AddBillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddBillServlet</servlet-name>
        <url-pattern>/addBill</url-pattern>
    </servlet-mapping>
    <!-- Admin: View All Bills -->
    <servlet>
        <servlet-name>ViewAllBillsServlet</servlet-name>
        <servlet-class>com.ebs.servlet.ViewAllBillsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewAllBillsServlet</servlet-name>
        <url-pattern>/viewAllBills</url-pattern>
    </servlet-mapping>

    <!-- Admin: View All Customers -->
    <servlet>
        <servlet-name>ViewCustomersServlet</servlet-name>
        <servlet-class>com.ebs.servlet.ViewCustomersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewCustomersServlet</servlet-name>
        <url-pattern>/viewCustomers</url-pattern>
    </servlet-mapping>

</web-app>
